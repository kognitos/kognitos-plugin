# Kognitos environment variables
# Copy to .env.local and fill in your values.

# Required — API key (Personal Access Token, prefix kgn_pat_). Create it in the
# Kognitos web app: user menu > API Keys. It only works in the organization it
# was created in.
KOGNITOS_TOKEN=

# The host you sign in to, without /api/v1. Organizations hosted in another
# region use that region's host (for example https://app.uk-1.kognitos.com).
KOGNITOS_BASE_URL=https://app.us-1.kognitos.com

# Organization and workspace IDs — discover these by listing orgs/workspaces
# with curl or the bootstrap skill after setting the token above.
KOGNITOS_ORGANIZATION_ID=
KOGNITOS_WORKSPACE_ID=
